current_branch=$(git symbolic-ref --short HEAD)

protected_branches="master prod"

# The first push of a new repository creates its protected branch; there is no PR to open yet.
creates_only=true
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_oid" in
    *[!0]*) creates_only=false ;;
  esac
done

if [ "$creates_only" = true ]; then
  echo "Push allowed: creating branches on a new remote"
  exit 0
fi

for branch in $protected_branches; do
  if [ "$current_branch" = "$branch" ]; then
    echo "Direct push to branch '$branch' is not allowed!"
    echo "Use Pull Request to make changes to '$branch'"
    exit 1
  fi
done

echo "Push allowed for branch '$current_branch'"
